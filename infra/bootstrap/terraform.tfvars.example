# Copy to terraform.tfvars and edit. .gitignore ignores terraform.tfvars (change
# request 1.5), so the copy stays on this workstation; this template stays tracked.
# Nothing here is secret: the file names a cell, a region, the principals allowed to
# run plans and the humans allowed to assume the teardown role.

cell   = "poc"
region = "us-east-1"

# The repository whose workflows run the plans, and the refs allowed to do it.
github_repository     = "your-org/spa-platform"
github_subject_claims = ["ref:refs/heads/main", "pull_request"]

# Set false, and give the ARN, when the account already has a GitHub Actions OIDC
# provider. An account may have only one.
create_github_oidc_provider = true
# github_oidc_provider_arn  = "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com"

# A deployer's role or another runner, if plans run outside GitHub Actions.
additional_trusted_principal_arns = []

# Leave off unless a CI plan must block a concurrent apply. See the README.
allow_state_lock = false

# The humans who may assume the teardown role, spa-platform-<cell>-teardown, which
# deletes published releases under apps/ (ADR-0014). Required: the apply fails on an
# empty list. IAM user or role ARNs only. A user assumes it only with MFA; a role is
# an allowlisted federated human role whose identity provider enforces MFA. Never
# the account root, never the assumed-role session ARN `aws sts get-caller-identity`
# prints, never the CI plan role.
teardown_trusted_principal_arns = ["arn:aws:iam::111122223333:user/operator"]

# The platform bucket the teardown role may empty. Empty means spa-platform-<cell>,
# modules/cell's default; set it only together with that module's bucket_name.
platform_bucket_name = ""
