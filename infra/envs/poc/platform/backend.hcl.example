# Copy to backend.hcl and fill in from the bootstrap root's `backend_blocks` output,
# then run `terraform init -backend-config=backend.hcl`.
#
# `key` is not here: it is fixed by convention, poc/platform/terraform.tfstate, and
# versions.tf carries it. These two are the values that cannot be, because the
# bucket's name is not known until infra/bootstrap has been applied.
bucket = "spa-platform-poc-tfstate-111122223333"
region = "us-east-1"
