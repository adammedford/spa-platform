# Copy to terraform.tfvars and edit. gateway_image and issuers have no default.

# The project's selected Region: AWS_REGION in tools/aws-project.env. Every
# root defaults to us-east-1, and the provider takes its Region from this
# variable before the environment, so this line is what puts the cell in the
# project's Region (change request 1.1).
region   = "us-east-2"
cell     = "poc"
vpc_cidr = "10.20.0.0/16"

# The wildcard certificate tools/scripts/certs.sh imported, without the wildcard.
certificate_domain = "spa-poc.test"

# / on the sample image, /readyz once the gateway runs.
health_check_path = "/"

# Deletes under apps/ are allowed to the teardown role infra/bootstrap creates,
# spa-platform-<cell>-teardown, which this root looks up by name: nothing to set
# here (change request 1.5, ADR-0014). Everyone else is denied, which is what
# makes a release prefix write-once. Add a principal only if it must delete as
# well; it is appended to the role, never instead of it. Role or user ARNs only,
# never the assumed-role session ARN `aws sts get-caller-identity` prints.
additional_teardown_principal_arns = []
