# The proof cell's entry file: the values the reference scripts in tools/scripts/ take from the
# environment, with no default, set to this project's own cell. Owner: workstream 1, AWS and IaC.
#
# Source it beside tools/aws-project.env, from the checkout's root, before any script of
# tools/scripts/ runs:
#
#   set -a; . tools/aws-project.env; . infra/envs/poc/cell.env; set +a
#
# The KEY=value form tools/aws-project.env uses, so `set -a` exports each line. It carries no account
# id, so it is tracked. A relative path is read from the checkout's root, the directory two above
# tools/scripts/, wherever the script is started from (tools/scripts/cell-common.sh, need_entry).
#
# What each value is, and which scripts read it, is tools/scripts/cell-common.sh's header. An adopter's
# operator writes the same keys for its own cell.

# The cell's name: its teardown role, its task definition families, its key ring prefix and its tags.
SPA_CELL=poc
# The certificate's domain: certs.sh issues *.<domain>, and each app's host is <app>.<domain>.
SPA_CERT_DOMAIN=spa-poc.test
# The platform root, the one that applies the cell module: its images, its bucket, its repositories.
SPA_PLATFORM_ROOT=infra/envs/poc/platform
# Every root of the cell, colon-separated, in the order they are applied: write_outputs reads them in
# this order, and teardown.sh destroys them in the reverse. A root's name is its directory's last
# segment, which the field map uses.
SPA_ROOTS=infra/envs/poc/idp:infra/envs/poc/apps:infra/envs/poc/platform
# The outputs document, contracts/infra-outputs.schema.json's, which write_outputs writes after every
# apply and the scripts read. git ignores it: it carries the account id and the apps' client ids.
SPA_OUTPUTS_FILE=infra/envs/poc/outputs.json
# The field map: which root's Terraform output answers each field of the outputs document.
SPA_FIELD_MAP=infra/envs/poc/outputs-fields.json
# The app host the tunnel scripts ask when no --host is given: tunnel.sh's --keepalive and
# verify-tunnel.sh. A host name alone, with no port: the proof cell's first app, fixtures/apps/app1.json's
# host without the :8443 its registry entry carries.
SPA_APP_HOST=app1.spa-poc.test
# The teardown judge: what verify-teardown.sh asks about a listed ARN of a type it does not know. The
# proof cell's drops the identity root's user pool once Cognito no longer describes it (#466).
SPA_TEARDOWN_JUDGE=tools/scripts/poc/teardown-judge.sh
