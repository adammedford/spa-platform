{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet build)",
      "Bash(dotnet test *)",
      "Bash(dotnet test)",
      "Bash(dotnet --info)",
      "Bash(dotnet --version)",
      "Bash(git merge-base *)",
      "Bash(git check-ignore *)",
      "Bash(terraform validate)",
      "Bash(terraform fmt *)",
      "Bash(terraform version)",
      "Bash(tools/preflight.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/main_checkout_guard.py\" || exec python3 -I \"$CLAUDE_PROJECT_DIR/tools/main_checkout_guard.py\""
          }
        ]
      }
    ]
  }
}
