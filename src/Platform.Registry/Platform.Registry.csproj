<Project Sdk="Microsoft.NET.Sdk">

  <!-- Owner: workstream 2. References Platform.Abstractions and no other workstream's project (check A-03). -->

  <ItemGroup>
    <ProjectReference Include="../Platform.Abstractions/Platform.Abstractions.csproj" />
  </ItemGroup>

  <!-- Plan row 2.1: "schema check" in the one library the gateway and spactl share. The 8.0.5 pin is
       the MIT release line (docs/dependencies.md, open decision D-1). Only RegistrySchemas touches it,
       so a different engine is a change to one file. -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- Plan row 2.5: the client secret source reads Parameter Store (ADR-0003). docs/dependencies.md
       assigns this package to this project. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" />
  </ItemGroup>

  <!-- Plan row 2.2: the S3 object store under the registry source. docs/dependencies.md assigns this
       package to this project and to spactl. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <!-- The contract schemas, embedded so the gateway image needs no contracts/ directory at run time.
       They are byte-for-byte copies of contracts/*.schema.json, kept here because the gateway image
       (src/Gateway/Dockerfile, the integrator's) copies only src/ into its build stage, so an Include of
       ../../contracts would break the image build. tests/Platform.Registry.Tests (SchemaCopyTests) fails
       when a copy differs from its contract, so the copies cannot drift. Change request
       contracts/changes/2.1-registry-schemas-and-jsonschema-net.md proposes linking contracts/ instead. -->
  <ItemGroup>
    <EmbeddedResource Include="Schemas/*.schema.json" LogicalName="contracts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
