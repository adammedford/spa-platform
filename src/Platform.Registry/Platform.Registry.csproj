<Project Sdk="Microsoft.NET.Sdk">

  <!-- Owner: workstream 2. References Platform.Abstractions and no other workstream's project (check A-03). -->

  <ItemGroup>
    <ProjectReference Include="../Platform.Abstractions/Platform.Abstractions.csproj" />
  </ItemGroup>

  <!-- Plan row 2.1: "schema check" in the one library the gateway and spactl share. The 8.0.5 pin is
       the MIT release line (docs/dependencies.md -> "Decided", D-1, which records the revisit trigger).
       Only RegistrySchemas touches it, so a different engine is a change to one file. -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- Plan row 2.5: the client secret source reads Parameter Store (ADR-0003). docs/dependencies.md
       assigns this package to this project. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" />
  </ItemGroup>

  <!-- Plan row 2.2: the S3 object store under the registry source. docs/dependencies.md assigns this
       package to this project and to spactl. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <!-- The contract schemas, embedded so the gateway image needs no contracts/ directory at run time.
       Linked from contracts/, which is the only copy: the gateway image (src/Gateway/Dockerfile, the
       integrator's) copies contracts/*.schema.json next to src/ in its build stage, so this Include
       resolves there as it does here (change request 2.1, decided 14 October 2026). LogicalName is what
       RegistrySchemas asks the assembly for, so it does not depend on where the file sits. -->
  <ItemGroup>
    <EmbeddedResource Include="../../contracts/*.schema.json" LogicalName="contracts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
