{
  "_comment": "The derived issue labels. tools/issue_labels.py reads this file and nothing else consumes it. Each group's labels are worked out from the issue alone; the triage labels and change-request are not here and are never touched.",
  "groups": ["kind", "area", "vendor"],
  "labels": [
    {"name": "kind:report", "color": "1d76db", "description": "A run's record: Overnight, Retro, Audit or Sequence <date>"},
    {"name": "kind:parent", "color": "1d76db", "description": "A spec or tracking issue: it has sub-issues"},
    {"name": "kind:ticket", "color": "1d76db", "description": "One unit of work, with no sub-issues"},
    {"name": "area:product", "color": "0e8a16", "description": "The gateway and its libraries: src/, tools/spactl, the product contracts, component tests"},
    {"name": "area:deployment", "color": "0e8a16", "description": "How a cell is stood up: infra/, tools/scripts/, images, runbooks"},
    {"name": "area:verification", "color": "0e8a16", "description": "Composed suites, e2e, the bench, fixtures, the test id register"},
    {"name": "area:build", "color": "0e8a16", "description": "CI, analyzers, packages and the local check"},
    {"name": "area:process", "color": "0e8a16", "description": "How the work is run: agent workflows, tracker and landing tools, agent docs"},
    {"name": "area:docs", "color": "0e8a16", "description": "The domain docs: glossary, ADRs, the plan and the roadmap"},
    {"name": "vendor:aws", "color": "d93f0b", "description": "Ties the work to AWS"},
    {"name": "vendor:cognito", "color": "d93f0b", "description": "Ties the work to Amazon Cognito as the identity provider"},
    {"name": "vendor:pingfederate", "color": "d93f0b", "description": "Ties the work to PingFederate as the identity provider"}
  ],
  "retire": ["good first issue", "help wanted", "question", "invalid", "duplicate", "documentation", "accessibility"],
  "reports": "^(Overnight|Retro|Audit|Sequence) \\d{4}-\\d{2}-\\d{2}\\b",
