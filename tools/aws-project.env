# Which AWS project this platform builds in. Owner: integrator.
#
# Read by tools/preflight.sh, which fails when the credentials in use do not match. Source it
# before an apply, or export AWS_PROFILE yourself:
#
#   set -a; . tools/aws-project.env; set +a
#
# Why this file exists. On 2026-10-15 a sitting applied the bootstrap root into the wrong project,
# because the default profile and the profile named for this work point at different ones. Nothing
# in the repository said which was intended, so a prompt asking "is this the right account?" had
# no value to check against and the answer was yes. The apply then failed against guardrails that
# the intended project does not have, which read as a platform problem for most of an evening.
#
# A profile NAME and a region, and deliberately no account id: an account id is not a credential,
# but it is an account identifier, and change request 1.5 decided such identifiers stay out of the
# repository. The profile is enough -- it resolves to the account, so holding the profile holds the
# account with it.

# The named profile in ~/.aws/config. Not "default": that is what went wrong.
SPA_AWS_PROFILE=spa-platform

# The project's selected Region. Under the new AWS experience a project has exactly one, set from
# the account's contact address, and regional resources cannot be created anywhere else. Every
# Terraform root must agree with it: three of the four default to us-east-1, so each needs this
# value set explicitly in its own terraform.tfvars rather than left to the default.
SPA_AWS_REGION=us-east-2
