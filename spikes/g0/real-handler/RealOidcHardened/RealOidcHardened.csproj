<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Review experiment: the spike's mechanism re-run against the REAL OpenIdConnectHandler (built from
       unmodified release/10.0 source in ../vendor) and a hermetic OpenID Connect provider. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/AspNetOidc/AspNetOidc.csproj" />
    <ProjectReference Include="../vendor/Protocols/Protocols.csproj" />
    <Reference Include="../vendor/lib/*.dll" />
  </ItemGroup>
</Project>
