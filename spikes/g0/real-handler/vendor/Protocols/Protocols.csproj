<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Review.IdentityModel.Protocols</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8632;SYSLIB0057;CA1416;CS0436</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="IgnoresAccessChecksTo.cs" />
    <Compile Include="../idm/src/Microsoft.IdentityModel.Protocols/**/*.cs" Exclude="../idm/src/Microsoft.IdentityModel.Protocols/Properties/AssemblyInfo.cs;../idm/src/Microsoft.IdentityModel.Protocols/InternalsVisibleTo.cs;../idm/src/**/obj/**;../idm/src/**/bin/**" />
    <Compile Include="../idm/src/Microsoft.IdentityModel.Protocols.OpenIdConnect/**/*.cs" Exclude="../idm/src/Microsoft.IdentityModel.Protocols.OpenIdConnect/Properties/AssemblyInfo.cs;../idm/src/**/obj/**;../idm/src/**/bin/**" />
    <Reference Include="../ref/*.dll" Private="false" />
  </ItemGroup>
</Project>
