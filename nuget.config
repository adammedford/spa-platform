<?xml version="1.0" encoding="utf-8"?>
<!-- One package source, so a machine-level feed can never change what restores. Owner: integrator. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
