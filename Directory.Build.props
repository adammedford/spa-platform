<Project>

  <!-- Build settings shared by every project in the solution. Owner: integrator.
       Projects under spikes/ do not inherit this file: spikes/Directory.Build.props stops the search. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A newly published package advisory warns. It must not stop every agent's build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Source analysis in every build, dotnet build, tools/check.sh, CI and each image's publish alike
       (ADR-0035 decisions 5 and 14). Every SDK rule is on, at warning, which TreatWarningsAsErrors
       makes an error; the root .globalconfig holds the per-id exceptions, a pending rule at
       suggestion or a decline, and the relaxed tier's relaxations are .editorconfig's last *.cs
       section.
       The level is pinned at 10, not latest, so that global.json's rollForward cannot add rules unseen.
       AnalysisLevelStyle must not equal AnalysisLevel: the SDK's code-style targets add the style
       rules' config only when the two differ (or the modes do, or the style level is 11 or later),
       so equal values turn every IDE rule off without a word (#588 measured it). The condition is
       the EditorConfigFiles item in Microsoft.CodeAnalysis.CSharp.CodeStyle.targets, under the
       SDK's Sdks/Microsoft.NET.Sdk/codestyle/cs/build/; SDK 10.0.401 builds that file from Roslyn's
       generator at the commit its csc names:
       https://github.com/dotnet/dotnet/blob/e34a38d2ae1fc26406a317517196e55c68ff83ab/src/roslyn/src/CodeStyle/Tools/Program.cs#L262-L266
       10.0-all is the same level and bucket as 10-all, written so it differs.
       The settings carry no condition on the analyzer configs. A build that reads this file without
       .editorconfig and .globalconfig beside it runs every rule at error with none of the exceptions,
       and fails, rather than publishing under the SDK's defaults unseen, as a missing banned list
       below fails the compile. Every Dockerfile copies the two configs with this file, and
       tools/image_build_tests.py holds each one's build-files line to the gateway's (#673). -->
  <PropertyGroup>
    <AnalysisLevel>10-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevelSecurity>10-all</AnalysisLevelSecurity>
    <AnalysisLevelStyle>10.0-all</AnalysisLevelStyle>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The analysis tier a project's files are in, by folder (ADR-0035 decision 3): the relaxed tier is
       every project under tests/, fixtures/, tools/spactl/, tools/bench/floor/ or src/Platform.Testing/,
       and everything else is the strict tier. The same five folders are .editorconfig's last *.cs
       section, which carries the relaxations; this property is for what a section cannot express,
       such as the strict tier's banned-symbol files (#608). -->
  <PropertyGroup>
    <_SpaProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_SpaProjectFolder>
    <SpaRelaxedTier>false</SpaRelaxedTier>
    <SpaRelaxedTier Condition="$(_SpaProjectFolder.StartsWith('tests/')) or $(_SpaProjectFolder.StartsWith('fixtures/')) or $(_SpaProjectFolder.StartsWith('tools/spactl/')) or $(_SpaProjectFolder.StartsWith('tools/bench/floor/')) or $(_SpaProjectFolder.StartsWith('src/Platform.Testing/'))">true</SpaRelaxedTier>
  </PropertyGroup>

  <!-- The banned-symbol lists, strict tier only (ADR-0035 decision 10; #608). BannedApiAnalyzers reads
       every AdditionalFile named BannedSymbols.*.txt and reports a use as RS0030, at its default
       warning, which TreatWarningsAsErrors makes an error. The relaxed tier carries none: its code
       never ships, and fixtures/TestIdp and tests/e2e need the primitives.
       The lists apply in every strict-tier build; every image copies them with the analyzer configs.
       No list is guarded by its own Exists: a missing one fails the compile
       (CS2001) rather than dropping its bans unseen. The file names, the // comments and the
       T:/N:/M: ids are the analyzer's documented format:
       https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/Microsoft.CodeAnalysis.BannedApiAnalyzers/BannedApiAnalyzers.Help.md
       That page does not say a namespace ban reaches child namespaces or that a type ban misses
       derived types; #608's throwaway calls showed both, which is why each HMAC subclass is listed. -->
  <ItemGroup Condition="'$(SpaRelaxedTier)' != 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Shipping.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.NotIdentity.txt" Condition="'$(MSBuildProjectName)' != 'Platform.Identity'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.NotProxy.txt" Condition="'$(MSBuildProjectName)' != 'Platform.Proxy'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.NoToken.txt" Condition="'$(MSBuildProjectName)' == 'Platform.Registry' or '$(MSBuildProjectName)' == 'Platform.Hosting' or '$(MSBuildProjectName)' == 'Platform.Security' or '$(MSBuildProjectName)' == 'Platform.Telemetry' or '$(MSBuildProjectName)' == 'Gateway'" />
  </ItemGroup>

  <!-- The admitted analyzer packages, in every project of the solution (ADR-0035 decision 9; #607).
       Each is an unconditional PackageReference rather than a GlobalPackageReference, which the pins
       sweep cannot see; PrivateAssets keeps the analyzer out of every consumer's dependencies. The
       versions are Directory.Packages.props's Analyzers group, and the root .globalconfig holds each
       package's declines and pending lines. -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- A project whose name ends in "Tests" is an xUnit v3 test project, set up as the xUnit template does:
       an executable that references xunit.v3 and runs on Microsoft Testing Platform (see global.json). -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <SpaTestProject>true</SpaTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(SpaTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
