#!/usr/bin/env bash
# Runs before every push. Owner: integrator.
#
# It catches, locally and in about a second, the three things that are expensive to find later:
# a change that touches a path outside its owner's set, a steering file that misleads every
# session that loads it, and a build that does not compile.
# The tests stay in CI, where they cost nothing to wait for.
#
# Enable it once per clone (not per worktree: the setting lives in the shared .git/config):
#
#     git config core.hooksPath .githooks
#
# A hook under .git/hooks is neither committed nor shared, which is why this lives here instead.
#
# To push past it deliberately: git push --no-verify. That is the escape, and using it means the
# push carries something CI will have an opinion about.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail() {
  echo "pre-push: $1" >&2
  echo "pre-push: fix it, or push with --no-verify if you mean it." >&2
  exit 1
}

# --- the author email -------------------------------------------------------------------------
#
# GitHub refuses a push carrying a private email when the account asks it to, and by then the
# history already has it: the only ways out are rewriting every commit or weakening an
# account-wide setting. Catch it at the first commit instead of the thirteenth.
noreply_domain="users.noreply.github.com"
author_email="$(git config user.email || true)"

[ -n "$author_email" ] || fail "git config user.email is unset."

case "$author_email" in
*@"$noreply_domain")
  : # The address GitHub hands out for exactly this. Nothing to check.
  ;;
*)
  echo "pre-push: warning: committing as '$author_email', not an @${noreply_domain} address." >&2
  echo "pre-push: if that address is private on GitHub, it will refuse the push." >&2
  ;;
esac

# --- check A-05: path ownership ---------------------------------------------------------------
#
# The only place this runs. A failure here is one amended commit; the same failure found after a
# push would cost a red pull request and buy nothing, since the same person reviews it either way.
# There is no override but --no-verify, which is the point: an override nobody can verify is a
# permissions model for a team of one.
if command -v python3 > /dev/null; then
  # The default branch, not this branch's upstream. The question is what this branch adds to main;
  # against its own upstream it would compare a branch to itself after the first push and pass on
  # an empty diff every time.
  base="origin/main"
  git rev-parse --verify --quiet "$base^{commit}" > /dev/null || base="main"

  if git rev-parse --verify --quiet "$base^{commit}" > /dev/null; then
    python3 -I .github/path-ownership.py "$base" HEAD || fail "check A-05 failed."
  else
    echo "pre-push: A-05 not checked: no '$base' to diff against." >&2
  fi
else
  echo "pre-push: A-05 not checked: python3 is not on PATH." >&2
fi

# --- the steering files -----------------------------------------------------------------------
#
# AGENTS.md and CLAUDE.md are loaded into every session. A progress claim or a pointer at a file
# that does not exist costs every later session, so catch it at the push that writes it.
if command -v python3 > /dev/null; then
  python3 -I .github/steering.py || fail "the steering check failed."
else
  echo "pre-push: steering not checked: python3 is not on PATH." >&2
fi

# --- duplicated build artifacts ---------------------------------------------------------------
#
# A worktree copied rather than cloned leaves files like "Platform.Abstractions 2.dll" and
# "project.assets 2.json" in bin/ and obj/. They do not fail the build. They make it lie: a project
# compiles clean while its consumer reports CS0103 on a type that is plainly there, and MSBuild
# reports an import "cannot be imported again" from a path with a space and a digit in it. That cost
# two debugging sessions and produced a confident wrong diagnosis in between, which is worse than a
# failure.
#
# Checked before the build, because the build is what the artifacts corrupt.
duplicates="$(find src tests fixtures \( -path "*/bin/*" -o -path "*/obj/*" \) -name "* [0-9].*" 2> /dev/null || true)"

if [ -n "$duplicates" ]; then
  echo "pre-push: duplicated build artifacts:" >&2
  echo "$duplicates" | head -5 >&2
  echo "pre-push: delete every bin/ and obj/ and build again:" >&2
  echo "  find src tests fixtures -type d \\( -name bin -o -name obj \\) -prune -exec rm -rf {} +" >&2
  fail "duplicated build artifacts make the build report errors that are not in the source."
fi

# --- the build --------------------------------------------------------------------------------
#
# Warnings are errors, so this catches what a reviewer should never have to.
command -v dotnet > /dev/null || fail "dotnet is not on PATH."
dotnet build --nologo --verbosity quiet > /dev/null || fail "the solution does not build."

# --- Terraform ---------------------------------------------------------------------------------
#
# The same argument as the build, for the other half of the repository. CI checks both; finding a
# misformatted root here costs an amended commit instead of a red pull request.
#
# -backend=false: validation needs no state and no credentials, which is also why it can run on a
# workstation that has never signed in to AWS.
if command -v terraform > /dev/null; then
  terraform fmt -check -recursive infra > /dev/null || fail "terraform fmt -check -recursive infra failed."

  for root in $(find infra -name '*.tf' -not -path '*/.terraform/*' -exec dirname {} \; | sort -u); do
    terraform -chdir="$root" init -backend=false -input=false > /dev/null 2>&1 \
      || fail "terraform init failed in $root."
    terraform -chdir="$root" validate > /dev/null || fail "terraform validate failed in $root."
  done
else
  echo "pre-push: Terraform not checked: terraform is not on PATH." >&2
fi

echo "pre-push: A-05, the steering files, the artifacts, the build and Terraform pass."
