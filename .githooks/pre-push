#!/usr/bin/env bash
# Runs before every push. Owner: integrator.
#
# It catches, locally, the things that are expensive to find later: a change that touches a path
# outside its owner's set, a steering document that misleads every session that reads it, a commit
# that changes one without naming its authority, a ticket citation that opens nothing, two tickets
# claiming one number, a build that does not compile and a Terraform root that does not validate.
# The tests stay in CI, where they cost nothing to wait for.
#
# The checks are tools/check.sh's, and its header says what each one catches and when it is
# skipped. A person runs the same file before a push, and every overnight lane runs it in full, so
# what holds a push here is what they checked (#68). This hook only calls it.
#
# Enable it once per clone (not per worktree: the setting lives in the shared .git/config):
#
#     git config core.hooksPath .githooks
#
# A hook under .git/hooks is neither committed nor shared, which is why this lives here instead.
#
# To push past it deliberately: git push --no-verify. That is the escape, and using it means the
# push carries something CI will have an opinion about.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# git passes the remote's name and URL as arguments and the refs on standard input
# (https://git-scm.com/docs/githooks#_pre_push). The check judges the branch against main, not
# against what is being pushed, so it takes neither.
#
# The bash running this hook runs the check, rather than whichever bash the script's shebang finds,
# so a hook started under the bash 3.2 macOS ships checks under it too.
exec "$BASH" tools/check.sh
