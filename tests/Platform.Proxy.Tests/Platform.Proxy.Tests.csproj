<Project Sdk="Microsoft.NET.Sdk">

  <!-- Component tests for Platform.Proxy, owned with it. -->

  <ItemGroup>
    <ProjectReference Include="../../src/Platform.Proxy/Platform.Proxy.csproj" />
    <ProjectReference Include="../../src/Platform.Abstractions/Platform.Abstractions.csproj" />
    <!-- Workstream 4's own: N-12's "the gateway's CSP" is UsePlatformSecurityHeaders overwriting what
         the proxy copied, so the one test of it puts that stage in front. A-03 binds src projects only. -->
    <ProjectReference Include="../../src/Platform.Security/Platform.Security.csproj" />
    <ProjectReference Include="../../src/Platform.Testing/Platform.Testing.csproj" />
  </ItemGroup>

  <!-- The registry schema, so ProxyTimeoutCeilingTests proves the proxy applies the maximum the contract
       states for apis[].timeoutSeconds, read from the contract rather than copied (ADR-0015 decision 3,
       ADR-0019 decision 4; CODING_STANDARDS.md, "A guard reads the thing it guards"). Read from
       contracts/, never edited. -->
  <ItemGroup>
    <None Include="../../contracts/registry.schema.json" Link="contracts/registry.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
