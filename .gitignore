# .NET
bin/
obj/
artifacts/
TestResults/
*.user
.vs/
.idea/

# Terraform. The provider lock file, .terraform.lock.hcl, is committed.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable and backend files are local: they carry role ARNs and the state bucket
# name, both of which carry the account id. Committed .example templates remain
# available: these patterns do not match them (change request 1.5).
*.tfvars
*.tfvars.json
backend.hcl

# Terraform plan files. A plan's `after` holds the values the apply will write, so the
# identity root's carries the generated test-user passwords and the apps root's carries
# the OAuth client secrets. Change request 1.1 also requires the documented recipe to
# write plans outside the tree; that recipe and the CI rule remain outstanding.
*.tfplan
*.tfplan.json

# The infrastructure outputs document (contracts/infra-outputs.schema.json), written by seed.sh,
# deploy.sh and rollback.sh after every apply. The bucket, the repositories and the gateway image
# in it carry the account id, and the apps' client ids are in it too (change requests 1.5 and 1.7
# item 1, #204).
infra/envs/poc/outputs.json

# Local certificate authority and keys made by tools/scripts/certs.sh. Never commit a private key.
*.pem
*.key
*.p12
*.pfx
*.srl
.certs/

# Local settings and secrets
.env
.env.*

# The account this platform builds in, one line, written by the AWS-sitting wizard after the human
# confirms the project's name. Change request 1.5 keeps account ids out of the tracked tree;
# tools/preflight.sh reads this to tell the platform project from the sample project `aws login`
# can also sign a profile into (GLOSSARY.md).
tools/aws-project.local.env
*.local.json

# Test output
playwright-report/
test-results/
*.trx

# G0 harness inputs fetched by hand: upstream source and Microsoft binaries
spikes/g0/real-handler/vendor/aspnetcore/
spikes/g0/real-handler/vendor/idm/
spikes/g0/real-handler/vendor/lib/
spikes/g0/real-handler/vendor/ref/

# Agent issue tracker (docs/agents/issue-tracker.md), tracked rather than ignored: it holds the spec
# every review's spec axis is held to, and the tickets that merge bodies, ADRs and contracts cite by
# path. While it was ignored those citations resolved on one machine and nowhere else -- ADR-0015
# promised three adoption tickets no second session could open. Only the session logs stay out, a
# transcript rather than a spec.
.scratch/*/log/

# Agent session scratch: worktrees and anything else a session leaves behind. Two exceptions:
# settings.json, because the permission allowlist is shared, like CI config is; and the workflow
# scripts under workflows/, because a workflow change is a branch, a review and a landing like any
# other integrator change (ADR-0026). The mock harness and its fixtures beside them stay ignored
# until #133's follow-up tracks the harness as the script's test companion.
# A negation cannot reach inside an ignored directory, so the directory's contents are listed
# rather than the directory itself, and the workflows folder is opened, closed and opened again
# for the scripts alone.
.claude/*
!.claude/settings.json
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/*.js
!.claude/workflows/overnight_tests.mjs
!.claude/workflows/fixtures/
!.claude/skills/

# Python bytecode. A companion that loads a sibling module by path, as tools/land_tests.py loads
# tools/companion_runner.py, leaves it beside that module under any python3 but the one macOS ships.
__pycache__/

# macOS and editors
.DS_Store
*.swp
