# .NET
bin/
obj/
artifacts/
TestResults/
*.user
.vs/
.idea/

# Terraform. The provider lock file, .terraform.lock.hcl, is committed.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local certificate authority and keys made by tools/scripts/certs.sh. Never commit a private key.
*.pem
*.key
*.p12
*.pfx
*.srl
.certs/

# Local settings and secrets
.env
.env.*
*.local.json

# Test output
playwright-report/
test-results/
*.trx

# G0 harness inputs fetched by hand: upstream source and Microsoft binaries
spikes/g0/real-handler/vendor/aspnetcore/
spikes/g0/real-handler/vendor/idm/
spikes/g0/real-handler/vendor/lib/
spikes/g0/real-handler/vendor/ref/

# Agent issue tracker (docs/agents/issue-tracker.md), tracked rather than ignored: it holds the spec
# every review's spec axis is held to, and the tickets that merge bodies, ADRs and contracts cite by
# path. While it was ignored those citations resolved on one machine and nowhere else -- ADR-0015
# promised three adoption tickets no second session could open. Only the session logs stay out, a
# transcript rather than a spec.
.scratch/*/log/

# Agent session scratch: worktrees and anything else a session leaves behind.
# settings.json is the exception: the permission allowlist is shared, like CI config is.
# A negation cannot reach inside an ignored directory, so the directory's contents are listed
# rather than the directory itself.
.claude/*
!.claude/settings.json

# macOS and editors
.DS_Store
*.swp
