<Project>

  <!-- Every package version in the solution. Owner: integrator.
       A project adds <PackageReference Include="Name" /> with no version, in its own project file.
       Each version below was confirmed to exist on nuget.org on 11 October 2026, unless its comment
       names a later date.
       docs/dependencies.md lists the licence of each and which project is expected to use it. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <!-- Check A-04: only Platform.Identity references the token-management package. -->
    <PackageVersion Include="Duende.AccessTokenManagement.OpenIdConnect" Version="4.2.0" />
    <!-- Fallback for G0 item 4 only. It is already a transitive dependency of the package above. -->
    <PackageVersion Include="Duende.IdentityModel" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup Label="Proxy">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="AWS">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.6" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.2" />
    <!-- #206: the project's profile signs in with login_session, which the .NET SDK resolves only when
         this assembly is present. 4.0.101.13 is the release whose AWSSDK.Core floor is 4.0.102.9, the
         Core this solution resolves (SimpleSystemsManagement's floor), from the same 8 October 2026
         SDK drop, so it moves no other version. Confirmed on nuget.org on 21 October 2026. -->
    <PackageVersion Include="AWSSDK.Signin" Version="4.0.101.13" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup Label="Fixtures">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Same IdentityModel version the two ASP.NET Core authentication packages depend on. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- Platform.Testing carries the store contract suites as xUnit base classes, so it needs the
         attributes and Assert without being an executable test project. xUnit refuses xunit.v3 on a
         library and names these two instead. Both ship in the same 4.0.2 set as xunit.v3 above and
         are already transitive dependencies of it. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- Decision D-1 in docs/dependencies.md. The 8.0.5 package declares MIT;
         the current 9.4.0 package carries a maintenance-fee licence. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

</Project>
