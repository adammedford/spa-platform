# The strict severities for the whole solution (ADR-0035 decision 5). Owner: integrator.
#
# Directory.Build.props switches every SDK rule on at warning, which TreatWarningsAsErrors makes an
# error, so a diagnostic id with no line here is at error. This file holds the exceptions, as
# per-id `dotnet_diagnostic.<id>.severity` lines only: no `dotnet_analyzer_diagnostic.category-*`
# line is written here or in any other analyzer config (ADR-0035 decision 5; tools/check.sh fails
# one). The relaxed tier's relaxations are .editorconfig's last *.cs section, not here.
#
# Two kinds of line:
#   - A pending rule (decision 6): one that fires today, held at suggestion until every project is
#     clean for it, with a comment naming its batch's promotion ticket. `grep pending .globalconfig`
#     lists them, and the promotion pull request deletes its batch's lines. The file printing no
#     pending line is the ramp's finished state.
#   - A decline (decision 8): a rule at none or silent for good, with its reason. Declining another
#     takes a new ADR.
# The admitted packages (decision 9) enter at their own DLL defaults, so a package rule with no
# line here is at that default: a warning, which is an error, or off. Their lines sit beside the
# SDK's, by the same two kinds (#607).

is_global = true

# --- the declines (ADR-0035 decision 8) ---------------------------------------------------------

# An ASP.NET Core host and tools/spactl have no SynchronizationContext, so ConfigureAwait changes
# nothing; Microsoft's page says to suppress the rule entirely for application code.
dotnet_diagnostic.CA2007.severity = none

# Whitespace formatting, which .editorconfig sets and the map ruled out of enforcement.
dotnet_diagnostic.IDE0055.severity = none

# The house style (decision 7): expression bodies are mixed, and only churn satisfies IDE0022.
dotnet_diagnostic.IDE0022.severity = silent

# The house style (decision 7): an unused value need not be discarded; `_ =` hardens nothing.
dotnet_diagnostic.IDE0058.severity = silent

# The same awaits as CA2007, declined for the same reason: Meziantou's ConfigureAwait rule.
dotnet_diagnostic.MA0004.severity = none

# The same awaits as CA2007, declined for the same reason: VS Threading's ConfigureAwait rule.
dotnet_diagnostic.VSTHRD111.severity = none

# VSTHRD200 is the one Async-suffix rule, matching Platform.Abstractions' existing convention.
dotnet_diagnostic.MA0137.severity = none

# BannedSymbols.*.txt is the one banned-list mechanism (decision 10), not BannedSyntaxes.txt.
dotnet_diagnostic.MA0240.severity = none

